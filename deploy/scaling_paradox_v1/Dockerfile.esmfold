FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/huggingface \
    ESMFOLD_DEVICE=cuda

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-pip python3-venv ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/pearl
COPY requirements.txt ./requirements.txt
RUN python3 -m pip install --break-system-packages --requirement requirements.txt

COPY src ./src
COPY scripts/run_scaling_paradox_structure.py ./scripts/run_scaling_paradox_structure.py
COPY configs/structure_gate_calibration.esmfold.json ./configs/structure_gate_calibration.esmfold.json
COPY configs/experiments/scaling_paradox_structural_v1.json ./configs/experiments/scaling_paradox_structural_v1.json
COPY deploy/scaling_paradox_v1/run_esmf_job.sh ./deploy/scaling_paradox_v1/run_esmf_job.sh
COPY input/generation_report.json /workspace/input/generation_report.json
RUN chmod 0755 ./deploy/scaling_paradox_v1/run_esmf_job.sh

ENTRYPOINT ["/workspace/pearl/deploy/scaling_paradox_v1/run_esmf_job.sh"]
